# ===================================================================
# INNOVATIONX - VERCEL ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ===================================================================
# Copy these variable names to your Vercel Project Settings:
# Settings -> Environment Variables
# Do NOT commit your real production passwords to GitHub.
# ===================================================================

# --- 1. SUPER ADMIN AUTHENTICATION (Set on Vercel) ---
# Your custom admin username
ADMIN_USERNAME=admin

# Your confidential admin password (setting this disables all hardcoded defaults)
ADMIN_PASSWORD=SetYourSecurePasswordHere123!

# 4-Digit 2-Step Verification Master PIN for Admin HQ
ADMIN_PIN=9999

# --- 2. CRYPTOGRAPHIC SESSION SECURITY ---
# A long, secure random key used to sign browser session cookies
SESSION_SECRET=ix_super_secret_cryptographic_key_replace_with_random_string_2026

# --- 3. PLATFORM URL ---
APP_URL=https://your-project.vercel.app

# --- 4. REMOTE DATABASE (OPTIONAL) ---
# If using Supabase, Neon, Railway, or Render PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- 5. VTU TELECOM INTEGRATION (OPTIONAL) ---
# Provider: omageneraldata, primebiller, vtpass, or clubkonnect
VTU_PROVIDER=omageneraldata
VTU_API_KEY=your_live_vtu_provider_token_here
VTU_API_BASE_URL=https://omageneraldata.com/api
